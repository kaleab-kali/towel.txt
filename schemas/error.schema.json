{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kaleab-kali/towel.txt/schemas/error.schema.json",
  "title": "Towel.txt JSON Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "schemaVersion"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitCode", "message", "name", "type"],
      "properties": {
        "exitCode": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": ["render_error", "strict_warning", "usage_error"]
        }
      }
    },
    "schemaVersion": {
      "const": 1
    }
  }
}
